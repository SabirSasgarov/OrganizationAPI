<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Organization Hub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Organization.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="app-nav" aria-label="Main navigation">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">O</span>
                <span>Organization Hub</span>
            </a>
            <div class="nav-links">
                <a asp-area="" asp-controller="Event" asp-action="Index">Events</a>
                <a asp-area="" asp-controller="Organizer" asp-action="Index">Organizers</a>
                <a asp-area="" asp-controller="Ticket" asp-action="Index">Tickets</a>
                <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                <a class="nav-cta" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div>
            &copy; 2026 Organization Hub
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
