@using Organization.MVC.Models.TicketViewModels
@model TicketCreateVM
@{
    ViewData["Title"] = "Create Ticket";
}

<section class="content-section">
    <div class="section-header">
        <div>
            <span class="eyebrow">Inventory</span>
            <h1>Create Ticket</h1>
        </div>
    </div>

    <div class="form-card">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="EventId" class="form-label"></label>
                <input asp-for="EventId" type="number" class="form-control" placeholder="Enter event ID" />
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Type" class="form-label"></label>
                <input asp-for="Type" class="form-control" placeholder="Enter ticket type (e.g., Standard, VIP, Premium)" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter ticket price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="QuantityAvailable" class="form-label"></label>
                <input asp-for="QuantityAvailable" type="number" class="form-control" placeholder="Enter available quantity" />
                <span asp-validation-for="QuantityAvailable" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Ticket</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
