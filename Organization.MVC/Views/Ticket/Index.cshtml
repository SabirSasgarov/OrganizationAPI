@using Organization.MVC.Models.TicketViewModels
@model List<TicketViewModel>
@{
    ViewData["Title"] = "Tickets";
}

<section class="content-section">
    <div class="section-header">
        <div>
            <span class="eyebrow">Inventory</span>
            <h1>Tickets</h1>
        </div>
        <div class="header-actions">
            <span class="pill">@Model.Count ticket type@(Model.Count == 1 ? "" : "s")</span>
            <a class="btn btn-primary" asp-controller="Ticket" asp-action="Create">Create ticket</a>
        </div>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Event ID</th>
                    <th>Event Title</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    @* <th>Actions</th> *@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="code-pill">#@item.EventId</span></td>
                        <td class="strong-cell">@(item.Event?.Title ?? "Untitled event")</td>
                        <td>@item.Type</td>
                        <td>@item.Price.ToString("C")</td>
                        <td><span class="status-badge">@item.QuantityAvailable</span></td>
                        @* <td>
                            <div class="action-buttons">
                                <a asp-action="Create" asp-route-id="@item.EventId" class="btn btn-sm btn-primary" title="Create new ticket">New</a>
                            </div>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
