@using Organization.MVC.Models
@model List<EventViewModel>
@{
    ViewData["Title"] = "Events";
}

<section class="content-section">
    <div class="section-header">
        <div>
            <span class="eyebrow">Catalog</span>
            <h1>Events</h1>
        </div>
        <span class="pill">@Model.Count event@(Model.Count == 1 ? "" : "s")</span>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Organizer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Tickets</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (item.BannerImage != null)
                        {
                            <td><img src="@item.BannerImage" style="width: 100px; height: 50px;"></td>
                        }
                        else
                        {
                            <td>
                                <img src="" style="width: 100px; height: 50px; position:absolute;">
                                <p style="position: absolute;">no image</p>
                            </td>
                        }
                        <td class="strong-cell">@item.Title</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "No description" : item.Description)</td>
                        <td>@item.Organizer.Name</td>
                        <td><a href="mailto:@item.Organizer.Email">@item.Organizer.Email</a></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Organizer.Phone) ? "N/A" : item.Organizer.Phone)</td>
                        <td>@item.Date.ToString("MMM dd, yyyy")</td>
                        <td>@item.Location</td>
                        <td><span class="status-badge">@(item.Tickets?.Count ?? 0)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
