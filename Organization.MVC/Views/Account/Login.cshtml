@using Organization.MVC.Models.AccountVMs
@{
    ViewData["Title"] = "Login";
}
@model LoginViewModel

<section class="auth-shell">
    <div class="auth-panel">
        <span class="eyebrow">Welcome back</span>
        <h1>Login</h1>
        <p>Access the organization workspace and continue managing event operations.</p>

        <form method="post" action="/Account/Login" class="app-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>

            <div class="form-group">
                <label for="UserName">Username</label>
                <input type="text" id="UserName" name="UserName" class="form-control" value="@Model.UserName" />
                <span asp-validation-for="UserName" class="field-validation"></span>
            </div>
            <div class="form-group">
                <label for="Password">Password</label>
                <input type="password" id="Password" name="Password" class="form-control" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-full">Login</button>
        </form>
    </div>
    <div class="auth-aside">
        <strong>Organization Hub</strong>
        <span>Events</span>
        <span>Organizers</span>
        <span>Tickets</span>
    </div>
</section>
