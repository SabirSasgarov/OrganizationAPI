@using Organization.MVC.Models
@model List<OrganizerViewModel>
@{
    ViewData["Title"] = "Organizers";
}

<section class="content-section">
    <div class="section-header">
        <div>
            <span class="eyebrow">Partners</span>
            <h1>Organizers</h1>
        </div>
        <span class="pill">@Model.Count organizer@(Model.Count == 1 ? "" : "s")</span>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Events</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (item.LogoUrl != null)
                        {
                            <td><img src="@item.LogoUrl" style="width: 30px; height: 30px;"></td>
                        }
                        else
                        {
                            <td>
                                <p>X</p>
                            </td>
                        }
                        <td class="strong-cell">@item.Name</td>
                        <td><a href="mailto:@item.Email">@item.Email</a></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Phone) ? "N/A" : item.Phone)</td>
                        <td><span class="status-badge">@(item.Events?.Count ?? 0)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
